#!/bin/sh
exec tail -n +3 $0

# Black Fox rescue entry.
# This layout assumes the files are stored in /boot on the filesystem
# searched by GRUB:
#   /boot/blackfox
#   /boot/blackfox.img
terminal_input console
terminal_output console

menuentry "Black Fox" {
    linux  /boot/blackfox rdinit=/init console=ttyS0 console=tty0 quiet
    initrd /boot/blackfox.img
}

# If /boot is a separate partition and the files are copied to its top level,
# use these paths instead:
#   search --no-floppy --file --set=root /blackfox
#   linux  /blackfox console=ttyS0 console=tty0 quiet
#   initrd /blackfox.img